---
import type { LinkItem } from "../data/links";

interface Props {
  link: LinkItem;
}

const { link } = Astro.props;
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  class="card group flex h-full items-center gap-4 p-4"
>
  <span class="text-2xl" aria-hidden="true">{link.emoji}</span>

  <span class="min-w-0 flex-1">
    <span class="flex items-center gap-2">
      <span class="h-2 w-2 shrink-0 rounded-full" style={{ backgroundColor: link.tint }} aria-hidden="true">
      </span>
      <span class="truncate font-medium">{link.label}</span>
    </span>
    <span class="mt-0.5 block text-sm text-[var(--color-muted)]">{link.blurb}</span>
  </span>

  <svg
    class="h-4 w-4 shrink-0 text-[var(--color-muted)] transition-transform group-hover:translate-x-0.5 group-hover:text-[var(--color-accent)]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M7 17 17 7" />
    <path d="M8 7h9v9" />
  </svg>

  <span class="sr-only">(opens in a new tab)</span>
</a>
