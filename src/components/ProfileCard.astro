---
import { profile } from "../data/links";
---

<header class="flex flex-col sm:flex-row items-center sm:items-center gap-4 sm:gap-6 text-center sm:text-left">
  <!-- Avatar (includes hot-pink comic ring and green status dot) -->
  <div class="relative shrink-0 w-28 h-28 sm:w-32 sm:h-32 transition-transform duration-200 hover:scale-105">
    <img
      src={profile.avatar}
      alt={profile.name}
      width="128"
      height="128"
      class="w-full h-full object-contain select-none drop-shadow-[0_4px_12px_rgba(0,0,0,0.5)]"
      loading="eager"
    />
  </div>

  <!-- Profile text info -->
  <div class="flex flex-col gap-1.5 sm:gap-2">
    <!-- Status pill -->
    <div class="flex items-center justify-center sm:justify-start">
      <div class="inline-flex items-center gap-2 bg-[#0c2e1d] border border-[#22c55e]/60 px-3 py-0.5 rounded-full text-xs font-semibold shadow-sm">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#4ade80] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[#22c55e]"></span>
        </span>
        <span class="text-[#4ade80] font-bold">{profile.status}</span>
        <span class="text-slate-300 font-normal">{profile.statusSub}</span>
      </div>
    </div>

    <!-- Name & Funny Title -->
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight flex flex-wrap items-baseline justify-center sm:justify-start gap-1.5">
      <span>{profile.name}</span>
      <span class="text-slate-300 font-normal text-lg sm:text-xl md:text-2xl">{profile.subname}</span>
    </h1>

    <!-- Headline / Bio -->
    <p class="text-slate-300 text-sm sm:text-base font-normal max-w-xl">
      {profile.headline}
    </p>
  </div>
</header>
