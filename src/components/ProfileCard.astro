---
import { profile } from "../data/links";
---

<header class="flex flex-col items-center gap-4 text-center">
  <div class="flex flex-col items-center gap-2">
    <div
      class="flex h-16 w-16 items-center justify-center rounded-full border border-[var(--color-border)] text-3xl select-none sm:h-20 sm:w-20 sm:text-4xl"
      aria-hidden="true"
    >
      {profile.emoji}
    </div>
    <span class="text-xs text-[var(--color-muted)]">{profile.emojiCaption}</span>
  </div>

  <div class="space-y-2">
    <h1 class="text-3xl font-semibold sm:text-4xl">{profile.name}</h1>
    <p class="text-[var(--color-muted)]">{profile.headline}</p>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm text-[var(--color-muted)]">
    <span class="inline-flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
      {profile.status}
    </span>
    <span class="hidden sm:inline" aria-hidden="true">·</span>
    <span>{profile.handle}</span>
  </div>

  <p class="max-w-md text-pretty text-sm text-[var(--color-muted)]">{profile.bio}</p>
</header>
