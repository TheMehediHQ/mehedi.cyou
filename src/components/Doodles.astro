---
// Background doodles, comic stickers, and neon borders
---

<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
  <!-- ================= NEON CORNER FRAMES ================= -->
  <!-- Top-left neon lime-green double hand-drawn lines -->
  <svg class="absolute top-0 left-0 w-64 h-64 opacity-95" viewBox="0 0 250 250" fill="none">
    <path d="M 16 230 L 18 20 L 240 18" stroke="#84f045" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M 8 245 L 10 10 L 140 10" stroke="#84f045" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.85" />
  </svg>

  <!-- Right neon pink vertical hand-drawn line -->
  <svg class="absolute top-4 right-1 w-6 h-full max-h-[92vh] opacity-95" viewBox="0 0 20 600" fill="none" preserveAspectRatio="none">
    <path d="M 10 0 L 8 300 L 10 600" stroke="#ff5ea5" stroke-width="3.5" stroke-linecap="round" />
  </svg>

  <!-- Bottom-right neon yellow hand-drawn lines -->
  <svg class="absolute bottom-0 right-0 w-80 sm:w-96 h-28 sm:h-36 opacity-95" viewBox="0 0 350 110" fill="none">
    <path d="M 10 98 L 338 99 L 336 8" stroke="#fed130" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M 110 105 L 344 106 L 342 35" stroke="#fed130" stroke-width="2.5" stroke-linecap="round" opacity="0.8" />
  </svg>

  <!-- ================= TOP LEFT CLUSTER ================= -->
  <!-- 404 Graffiti Top Left -->
  <div class="absolute top-6 left-12 sm:left-18 font-doodle text-3xl sm:text-4xl font-extrabold text-[#2a3449] -rotate-12 select-none tracking-wider">
    404
  </div>

  <!-- Spilled Coffee 1 (Top Left, near avatar) -->
  <div class="absolute top-4 sm:top-6 left-28 sm:left-38 pointer-events-auto sticker-hover rotate-6">
    <img
      src="/doodle_coffee1.png"
      alt="Spilled coffee"
      width="68"
      height="48"
      class="w-13 sm:w-15 h-auto drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]"
    />
  </div>

  <!-- Spilled Coffee 2 (Middle Left, below cup 1) -->
  <div class="absolute top-18 sm:top-22 left-18 sm:left-24 pointer-events-auto sticker-hover -rotate-6">
    <img
      src="/doodle_coffee2.png"
      alt="Spilled coffee again"
      width="64"
      height="48"
      class="w-12 sm:w-14 h-auto drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]"
    />
  </div>

  <!-- Cute Robot Doodle (Left) -->
  <div class="hidden lg:block absolute top-40 left-10 pointer-events-auto sticker-hover -rotate-3">
    <img
      src="/doodle_robot.png"
      alt="Robot"
      width="60"
      height="65"
      class="w-11 h-auto opacity-85 hover:opacity-100"
    />
  </div>

  <!-- 404 Monitor Doodle -->
  <div class="hidden xl:block absolute top-[52%] left-14 pointer-events-auto sticker-hover rotate-6">
    <img
      src="/doodle_monitor404.png"
      alt="404 Monitor"
      width="65"
      height="65"
      class="w-13 h-auto opacity-85 hover:opacity-100"
    />
  </div>

  <!-- 404 Graffiti Bottom Left -->
  <div class="absolute bottom-24 left-8 sm:left-14 font-doodle text-4xl sm:text-5xl font-extrabold text-[#253043] rotate-6 select-none tracking-wider">
    404
  </div>

  <!-- BUG sticker bottom left -->
  <div class="absolute bottom-12 left-12 sm:left-16 pointer-events-auto sticker-hover -rotate-12">
    <img
      src="/doodle_bug_left.png"
      alt="BUG sticker"
      width="65"
      height="38"
      class="w-14 sm:w-15 h-auto drop-shadow-md"
    />
  </div>

  <!-- Ladybug sticker bottom left -->
  <div class="absolute bottom-6 left-28 sm:left-34 pointer-events-auto sticker-hover">
    <img
      src="/doodle_ladybug.png"
      alt="Ladybug"
      width="55"
      height="55"
      class="w-11 sm:w-12 h-auto drop-shadow-md"
    />
  </div>

  <!-- ================= TOP RIGHT CLUSTER ================= -->
  <!-- Warning Triangle Sign -->
  <div class="absolute top-5 sm:top-7 right-32 sm:right-48 pointer-events-auto sticker-hover rotate-6">
    <img
      src="/doodle_warning.png"
      alt="Warning sign"
      width="55"
      height="65"
      class="w-12 sm:w-13 h-auto drop-shadow-md"
    />
  </div>

  <!-- Desktop Folders Top Right -->
  <div class="hidden lg:flex flex-col items-center gap-2.5 absolute top-5 right-8 pointer-events-auto select-none">
    <div class="flex flex-col items-center text-[10px] text-slate-300 font-medium sticker-hover">
      <img src="/doodle_folder1.png" alt="Comments Features" width="38" height="34" class="w-8.5 h-auto" />
      <span class="mt-0.5 leading-tight text-center">Comments<br />Features</span>
    </div>
    <div class="flex flex-col items-center text-[10px] text-slate-300 font-medium sticker-hover">
      <img src="/doodle_folder2.png" alt="Studio Sand" width="38" height="34" class="w-8.5 h-auto" />
      <span class="mt-0.5 leading-tight text-center">Studio Sand</span>
    </div>
  </div>

  <!-- 404 Graffiti Top Right -->
  <div class="absolute top-18 right-20 sm:right-32 font-doodle text-3xl sm:text-4xl font-extrabold text-[#253043] rotate-12 select-none tracking-wider">
    404
  </div>

  <!-- #gofhenn Hashtag Sticker -->
  <div class="absolute top-28 sm:top-32 right-28 sm:right-44 pointer-events-auto sticker-hover -rotate-12">
    <img
      src="/doodle_hashtag.png"
      alt="#gofhenn hashtag"
      width="85"
      height="35"
      class="w-18 sm:w-22 h-auto drop-shadow-md"
    />
  </div>

  <!-- BUG sticker Middle Right -->
  <div class="hidden sm:block absolute top-[32%] right-6 sm:right-12 pointer-events-auto sticker-hover rotate-12">
    <img
      src="/doodle_bug_right.png"
      alt="BUG sticker"
      width="70"
      height="42"
      class="w-15 sm:w-16 h-auto drop-shadow-md"
    />
  </div>

  <!-- 404 Graffiti Middle Right -->
  <div class="absolute top-[50%] right-8 sm:right-14 font-doodle text-4xl sm:text-5xl font-extrabold text-[#253043] -rotate-6 select-none tracking-wider">
    404
  </div>

  <!-- Spilled Dark Coffee Puddle (Bottom Right) -->
  <div class="hidden sm:block absolute bottom-22 right-10 sm:right-16 pointer-events-auto sticker-hover">
    <img
      src="/doodle_coffee_puddle.png"
      alt="Spilled dark coffee puddle"
      width="85"
      height="60"
      class="w-18 sm:w-20 h-auto opacity-80 hover:opacity-100 drop-shadow-md"
    />
  </div>
</div>

