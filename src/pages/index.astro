---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileCard from "../components/ProfileCard.astro";
import LinkCard from "../components/LinkCard.astro";
import Doodles from "../components/Doodles.astro";
import { linkCards } from "../data/links";
---

<BaseLayout>
  <!-- Background doodles, stickers, and neon frames -->
  <Doodles />

  <main
    class="relative z-10 mx-auto flex min-h-screen w-full max-w-4xl flex-col justify-between px-6 py-3 sm:py-5"
  >
    <!-- Profile Header -->
    <div class="pt-1">
      <ProfileCard />
    </div>

    <!-- 6 Neo-Brutalist Link Cards -->
    <section aria-label="Links" class="my-3 sm:my-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-4">
        {
          linkCards.map((card) => (
            <LinkCard card={card} showPointer={card.id === "cv"} />
          ))
        }
      </div>
    </section>

    <!-- Footer with Comic Bursts -->
    <footer
      class="flex items-center justify-center gap-2.5 pb-2 text-center text-xs sm:text-sm text-slate-300 select-none"
    >
      <!-- Pink sketchy burst -->
      <svg
        width="22"
        height="22"
        viewBox="0 0 30 30"
        fill="none"
        class="shrink-0 animate-pulse"
      >
        <path
          d="M 15 2 L 18 11 L 28 8 L 21 16 L 27 24 L 17 21 L 13 29 L 10 20 L 2 21 L 8 14 L 3 7 L 12 10 Z"
          stroke="#ff69a6"
          stroke-width="2.5"
          stroke-linejoin="round"></path>
      </svg>

      <p class="font-normal tracking-wide">
        © 2026 Mehedi. No bugs were harmed (just created).
      </p>

      <!-- Lime green sketchy burst -->
      <svg
        width="22"
        height="22"
        viewBox="0 0 30 30"
        fill="none"
        class="shrink-0 animate-pulse"
        style="animation-delay: 500ms;"
      >
        <path
          d="M 15 2 L 18 11 L 28 8 L 21 16 L 27 24 L 17 21 L 13 29 L 10 20 L 2 21 L 8 14 L 3 7 L 12 10 Z"
          stroke="#84f045"
          stroke-width="2.5"
          stroke-linejoin="round"></path>
      </svg>
    </footer>
  </main>
</BaseLayout>
